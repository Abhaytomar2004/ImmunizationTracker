pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
        MINIKUBE_HOME = 'C:\\minikube'  
        KUBECONFIG = "${env.MINIKUBE_HOME}\\config"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                       def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                       env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                   docker.image(env.IMAGE_NAME).push()
                    }
                }
            }
        }
        // ---- Kubernetes Steps Start Here (fixed and simplified) ----
        stage('Start Minikube') {
            steps {
                script {
                bat '''
                        @echo off
                        minikube status > nul 2>&1 && (
                            echo Found existing cluster, deleting...
                            minikube delete
                        ) || (
                            echo No existing cluster found
                        )
                    '''
                    
                    // Start cluster with explicit path configuration
                    bat """
                        minikube start --driver=docker --cpus=2 --memory=3759 ^
                        --alsologtostderr -v=3 ^
                        --kubernetes-version=v1.33.1 ^
                        --kubeconfig="${env.KUBECONFIG}"
                    """
                    
                    // Verify cluster with retries
                    bat """
                        minikube status
                        kubectl cluster-info
                        kubectl get nodes
                    """
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                dir('ImmunizationTracker/k8s') {
                    script {
                           bat 'timeout /t 30'
                        
                        bat """
                            kubectl apply -f mysql-pv.yaml
                            kubectl apply -f mysql-deployment.yaml
                            kubectl wait --for=condition=available deployment/mysql --timeout=300s
                            kubectl apply -f deployment.yaml
                            kubectl apply -f service.yaml
                            kubectl rollout status deployment/immunization-tracker --timeout=300s
                            minikube service immunization-tracker --url
                        """
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
