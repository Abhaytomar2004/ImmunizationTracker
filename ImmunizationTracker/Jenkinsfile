pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
    DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
    // Fix paths for Windows Jenkins
    KUBECONFIG = "${env.MINIKUBE_HOME}\\config"
    MINIKUBE_HOME = "C:\\minikube".replace('\\', '/')

}
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Test') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn test -DskipTests' // Remove -DskipTests to actually run tests
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                        env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        docker.image(env.IMAGE_NAME).push()
                    }
                }
            }
        }
      stage('Verify Kubernetes Cluster') {
    steps {
        script {
            // Completely reset Minikube
            bat 'minikube delete --all --purge || echo "No existing cluster to delete"'
            
            // Start fresh cluster with explicit config
            bat '''
            minikube start \
              --driver=docker \
              --cpus=2 \
              --memory=4096 \
              --alsologtostderr \
              --force \
              --embed-certs
            '''
            
            // Generate and load kubeconfig
            bat 'minikube update-context'
            bat 'copy /Y %USERPROFILE%\\.kube\\config %MINIKUBE_HOME%\\config'
            
            // Verify access
            bat 'kubectl cluster-info'
            bat 'kubectl get nodes'
        }
    }
}
      stage('Deploy to Kubernetes') {
    steps {
        dir('ImmunizationTracker') {
            script {
                // Load Minikube environment explicitly
                bat 'minikube docker-env --shell cmd > minikube-env.cmd'
                bat 'call minikube-env.cmd'
                
                // Apply manifests with validation disabled
                def k8sFiles = [
                    'mysql-pv.yaml',
                    'mysql-deployment.yaml',
                    'deployment.yaml',
                    'service.yaml'
                ]
                
                k8sFiles.each { file ->
                    bat "kubectl apply -f k8s/${file} --validate=false || echo \"Failed ${file}\""
                }
                
                // Extended wait for MySQL
                retry(5) {
                    bat 'kubectl wait --for=condition=ready pod -l app=mysql --timeout=300s'
                }
            }
        }
    }
}
    post {
        always {
            cleanWs()
        }
    }
}
