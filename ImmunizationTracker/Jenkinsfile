pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Test') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn test -DskipTests'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        // Build Docker image with your Docker Hub username
                        def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                        // Store image name in environment variable for later stages
                        env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        def image = docker.image(env.IMAGE_NAME)
                        image.push()
                    }
                }
            }
        }
        stage('Verify Kubernetes Cluster') {
    steps {
        script {
            // Ensure kubectl is configured properly
            bat 'kubectl config view'
            
            // Verify cluster connectivity
            bat 'kubectl cluster-info || minikube status'
            
            // If using Minikube, ensure it's running
            bat 'minikube status || minikube start'
            
            // Update kubeconfig if needed
            bat 'minikube update-context'
        }
    }
}
       stage('Deploy to Kubernetes') {
    steps {
        dir('ImmunizationTracker') {
            script {
                // Verify cluster connection first
                bat 'kubectl cluster-info'
                
                // Apply manifests with validation disabled if needed
                def files = [
                    'k8s/mysql-pv.yaml',
                    'k8s/mysql-deployment.yaml', 
                    'k8s/deployment.yaml',
                    'k8s/service.yaml'
                ]
                
                files.each { file ->
                    if (fileExists(file)) {
                        try {
                            bat "kubectl apply -f ${file}"
                        } catch (e) {
                            // Try with validation disabled if first attempt fails
                            bat "kubectl apply -f ${file} --validate=false"
                            echo "Applied ${file} with validation disabled"
                        }
                    }
                }
                
                // Wait for MySQL with retries
                retry(3) {
                    bat 'kubectl wait --for=condition=ready pod -l app=mysql --timeout=120s'
                }
            }
        }
    }
}
    post {
        always {
            cleanWs()
        }
    }
}
