pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
        MINIKUBE_HOME = 'C:/minikube'
        KUBECONFIG = "${env.MINIKUBE_HOME.replace('\\','/')}/config"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                       def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                       env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                   docker.image(env.IMAGE_NAME).push()
                    }
                }
            }
        }
        // ---- Kubernetes Steps Start Here (fixed and simplified) ----
        stage('Start Minikube') {
            steps {
                script {
                  bat 'minikube status && minikube delete || echo "No existing cluster to delete"'
            // Start cluster with your working configuration
            bat 'minikube start --driver=docker --cpus=2 --memory=3759'
            // Verify cluster is ready (no need for verbose flags since manual test worked)
            bat 'minikube status'
            // Optional: Add this if you need to wait for cluster components
            bat 'kubectl wait --for=condition=Ready nodes --all --timeout=120s'
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                dir('ImmunizationTracker/k8s') {
                    script {
                         bat 'kubectl apply -f mysql-pv.yaml'
                bat 'kubectl apply -f mysql-deployment.yaml'
                // Wait for MySQL to be fully ready
                bat 'kubectl wait --for=condition=available deployment/mysql --timeout=300s'
                // Deploy main application
                bat 'kubectl apply -f deployment.yaml'
                bat 'kubectl apply -f service.yaml'
                // Verify application deployment
                bat 'kubectl rollout status deployment/immunization-tracker --timeout=300s'
                // Optional: Get service URL for verification
                bat 'minikube service immunization-tracker --url'
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
