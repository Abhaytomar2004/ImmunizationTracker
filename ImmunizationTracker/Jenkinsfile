pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
        MINIKUBE_HOME = 'C:\\minikube'  
        KUBECONFIG = "${env.MINIKUBE_HOME}\\config"
        DOCKER_CONFIG = 'C:\\Users\\abhay tomar\\.docker'
    }
    stages {
        stage('Check Jenkins User Context') {
            steps {
                script {
                    try {
                        bat '''
                            echo === JENKINS USER CONTEXT CHECK ===
                            
                            echo Current User:
                            whoami
                            
                            echo User Groups:
                            whoami /groups
                            
                            echo Environment Variables:
                            echo USERPROFILE: %USERPROFILE%
                            echo USERNAME: %USERNAME%
                            echo PATH: %PATH%
                        '''
                    } catch (Exception e) {
                        echo "User context check failed: ${e.getMessage()}"
                    }
                }
            }
        }
        
        stage('Check Docker Access from Jenkins') {
            steps {
                script {
                    try {
                        bat '''
                            echo === DOCKER ACCESS CHECK ===
                            
                            echo Docker Version:
                            docker --version 2>nul || echo "Docker command failed"
                            
                            echo Docker Info:
                            docker info 2>nul || echo "Docker info failed"
                            
                            echo Docker PS:
                            docker ps 2>nul || echo "Docker ps failed"
                        '''
                    } catch (Exception e) {
                        echo "Docker access check failed: ${e.getMessage()}"
                    }
                }
            }
        }
        
        stage('Check Minikube Access from Jenkins') {
            steps {
                script {
                    try {
                        bat '''
                            echo === MINIKUBE ACCESS CHECK ===
                            
                            echo Minikube Version:
                            minikube version 2>nul || echo "Minikube command failed"
                            
                            echo Minikube Config Location:
                            echo Expected: %USERPROFILE%\\.minikube
                            dir "%USERPROFILE%\\.minikube" 2>nul || echo "Minikube config directory not found"
                            
                            echo Checking for existing cluster:
                            minikube status 2>nul || echo "No active minikube cluster"
                            
                            echo Checking profiles (this may show an error if no profiles exist - that's normal):
                            minikube profile list 2>nul || echo "No minikube profiles found - will create one"
                            
                            exit 0
                        '''
                    } catch (Exception e) {
                        echo "Minikube access check completed with warnings: ${e.getMessage()}"
                    }
                }
            }
        }
        
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                       def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                       env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        docker.image(env.IMAGE_NAME).push()
                    }
                }
            }
        }
        
        stage('Start Minikube') {
            steps {
                script {
                    try {
                        // Clean up any existing clusters first
                        bat '''
                            @echo off
                            echo Checking for existing minikube clusters...
                            minikube status >nul 2>&1
                            if %ERRORLEVEL% EQU 0 (
                                echo Found existing cluster, deleting...
                                minikube delete --all
                                timeout /t 10 /nobreak >nul
                            ) else (
                                echo No existing cluster found, proceeding with fresh start
                            )
                        '''
                    } catch (Exception e) {
                        echo "Cluster cleanup completed: ${e.getMessage()}"
                    }
            
                    // Start cluster with more conservative settings
                    bat """
                        echo Starting new minikube cluster...
                        minikube start --driver=docker --cpus=2 --memory=2500 ^
                        --kubernetes-version=v1.28.0 ^
                        --kubeconfig="${env.KUBECONFIG}" ^
                        --force
                    """
            
                    // Add verification with retries
                    retry(3) {
                        bat """
                            echo Verifying cluster status...
                            minikube status
                            kubectl cluster-info
                            kubectl get nodes
                        """
                    }
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                dir('ImmunizationTracker/k8s') {
                    script {
                        // Debug: Check what files are available
                        bat '''
                            echo Current directory:
                            cd
                            echo Files in current directory:
                            dir /b
                            
                            echo Checking for k8s directory:
                            if exist "k8s" (
                                echo k8s directory found
                                dir k8s /b
                            ) else (
                                echo k8s directory not found, checking parent directories
                                cd ..
                                dir /b | findstr k8s
                            )
                        '''
            
                        // Apply Kubernetes manifests - adjust path as needed
                        bat '''
                            echo Applying Kubernetes manifests...
                            
                            if exist "mysql-pv.yaml" (
                                kubectl apply -f mysql-pv.yaml
                            ) else if exist "k8s\\mysql-pv.yaml" (
                                kubectl apply -f k8s\\mysql-pv.yaml
                            ) else (
                                echo mysql-pv.yaml not found
                            )
                            
                            if exist "mysql-deployment.yaml" (
                                kubectl apply -f mysql-deployment.yaml
                                kubectl wait --for=condition=available deployment/mysql --timeout=300s
                            ) else if exist "k8s\\mysql-deployment.yaml" (
                                kubectl apply -f k8s\\mysql-deployment.yaml
                                kubectl wait --for=condition=available deployment/mysql --timeout=300s
                            ) else (
                                echo mysql-deployment.yaml not found
                            )
                            
                            if exist "deployment.yaml" (
                                kubectl apply -f deployment.yaml
                                kubectl apply -f service.yaml
                            ) else if exist "k8s\\deployment.yaml" (
                                kubectl apply -f k8s\\deployment.yaml
                                kubectl apply -f k8s\\service.yaml
                            ) else (
                                echo deployment.yaml not found
                            )
                            
                            kubectl rollout status deployment/immunization-tracker --timeout=300s
                            minikube service immunization-tracker --url
                        '''
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
        failure {
            echo "Pipeline failed. Check the logs above for details."
        }
    }
}
