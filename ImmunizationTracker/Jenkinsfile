pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
        MINIKUBE_HOME = 'C:\\minikube'  
        KUBECONFIG = "${env.MINIKUBE_HOME}\\config"
        DOCKER_CONFIG = 'C:\\Users\\abhay tomar\\.docker'
    }
    stages {
         stage('Check Jenkins User Context') {
            steps {
                bat '''
                    echo === JENKINS USER CONTEXT CHECK ===
                    
                    echo Current User:
                    whoami
                    
                    echo User Groups:
                    whoami /groups
                    
                    echo User Privileges:
                    whoami /priv
                    
                    echo Environment Variables:
                    echo USERPROFILE: %USERPROFILE%
                    echo USERNAME: %USERNAME%
                    echo TEMP: %TEMP%
                    echo APPDATA: %APPDATA%
                    
                    echo PATH: %PATH%
                '''
            }
        }
        stage('Check Docker Access from Jenkins') {
            steps {
                bat '''
                    echo === DOCKER ACCESS CHECK ===
                    
                    echo Docker Version:
                    docker --version || echo "Docker command failed"
                    
                    echo Docker Info:
                    docker info || echo "Docker info failed"
                    
                    echo Docker PS:
                    docker ps || echo "Docker ps failed"
                    
                    echo Docker System Info:
                    docker system info --format "Server Version: {{.ServerVersion}}" || echo "Docker system info failed"
                '''
            }
        }
        stage('Check Minikube Access from Jenkins') {
            steps {
                bat '''
                    echo === MINIKUBE ACCESS CHECK ===
                    
                    echo Minikube Version:
                    minikube version || echo "Minikube command failed"
                    
                    echo Minikube Config Location:
                    echo Expected: %USERPROFILE%\\.minikube
                    dir "%USERPROFILE%\\.minikube" 2>nul || echo "Minikube config directory not found"
                    
                    echo Minikube Status:
                    minikube status || echo "No minikube cluster running"
                    
                    echo Minikube Profile List:
                    minikube profile list || echo "No minikube profiles found"
                '''
            }
        }
        stage('Check File Permissions') {
            steps {
                bat '''
                    echo === FILE PERMISSIONS CHECK ===
                    
                    echo Testing write access to user profile:
                    echo test > "%USERPROFILE%\\jenkins_test.txt" && (
                        echo SUCCESS: Can write to user profile
                        del "%USERPROFILE%\\jenkins_test.txt"
                    ) || echo FAILED: Cannot write to user profile
                    
                    echo Testing Docker socket access:
                    echo. | docker version --format "{{.Server.Version}}" >nul 2>&1 && (
                        echo SUCCESS: Can access Docker daemon
                    ) || echo FAILED: Cannot access Docker daemon
                '''
            }
        }
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                       def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                       env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        docker.image(env.IMAGE_NAME).push()
                    }
                }
            }
        }
        stage('Start Minikube') {
            steps {
                script {
                    bat '''
                        @echo off
                        minikube status > nul 2>&1 && (
                            echo Found existing cluster, deleting...
                            minikube delete
                        ) || (
                            echo No existing cluster found
                        )
                    '''
            
                    // Start cluster with more conservative settings
                    bat """
                        minikube start --driver=docker --cpus=2 --memory=2500 ^
                        --kubernetes-version=v1.28.0 ^
                        --kubeconfig="${env.KUBECONFIG}"
                    """
            
                    // Add verification with retries
                    retry(3) {
                        bat """
                            minikube status
                            kubectl cluster-info
                            kubectl get nodes
                        """
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                dir('ImmunizationTracker/k8s') {
                    script {
                        bat '''
                            cd ImmunizationTracker/k8s
                            dir /b
                            echo Content of mysql-pv.yaml:
                            type mysql-pv.yaml
                        '''
            
                        // Apply Kubernetes manifests with debug info
                        bat '''
                            kubectl apply -f ImmunizationTracker/k8s/mysql-pv.yaml
                            kubectl apply -f ImmunizationTracker/k8s/mysql-deployment.yaml
                            kubectl wait --for=condition=available deployment/mysql --timeout=300s
                            
                            kubectl apply -f ImmunizationTracker/k8s/deployment.yaml
                            kubectl apply -f ImmunizationTracker/k8s/service.yaml
                            kubectl rollout status deployment/immunization-tracker --timeout=300s
                            
                            minikube service immunization-tracker --url
                        '''
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
