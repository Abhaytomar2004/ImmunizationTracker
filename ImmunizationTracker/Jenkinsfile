pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
            jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Test') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn test -DskipTests'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                      docker build -f ImmunizationTracker/Dockerfile -t abhaytomar2004/immunizationtracker:16 ImmunizationTracker/

                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
            def image = docker.build('abhaytomar2004/immunizationtracker:16')
            image.push()
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'kubectl apply -f k8s/mysql-pv.yaml'
                    bat 'kubectl apply -f k8s/mysql-deployment.yaml'
                    bat 'kubectl wait --for=condition=ready pod -l app=mysql --timeout=120s'
                    bat 'kubectl apply -f k8s/deployment.yaml'
                    bat 'kubectl apply -f k8s/service.yaml'
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
