pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
        // Point to Minikube's Docker daemon
        DOCKER_HOST = 'tcp://127.0.0.1:2375'
    }
    stages {
        stage('Setup Minikube Environment') {
            steps {
                script {
                    // Ensure Minikube is running
                    bat 'minikube status || minikube start --driver=docker'
                    
                    // Configure Docker to use Minikube's daemon
                    bat 'minikube docker-env --shell cmd | find "SET" > minikube-env.cmd'
                    bat 'call minikube-env.cmd'
                    
                    // Verify Kubernetes access
                    bat 'kubectl cluster-info'
                }
            }
        }
        
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        
        stage('Test') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn test'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        // Build using Minikube's Docker daemon
                        def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                        env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        docker.image(env.IMAGE_NAME).push()
                        // Also tag as latest and push
                        docker.image(env.IMAGE_NAME).tag('arnold21/immunizationtracker:latest')
                        docker.image('arnold21/immunizationtracker:latest').push()
                    }
                }
            }
        }
        
        stage('Deploy to Minikube') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        // Load Minikube environment
                        bat 'minikube docker-env --shell cmd | find "SET" > minikube-env.cmd'
                        bat 'call minikube-env.cmd'
                        
                        // Apply Kubernetes manifests in order
                        def k8sFiles = [
                            'k8s/mysql-pv.yaml',
                            'k8s/mysql-deployment.yaml',
                            'k8s/deployment.yaml',
                            'k8s/service.yaml'
                        ]
                        
                        k8sFiles.each { file ->
                            if (fileExists(file)) {
                                bat "kubectl apply -f ${file}"
                            }
                        }
                        
                        // Wait for MySQL to be ready
                        if (fileExists('k8s/mysql-deployment.yaml')) {
                            bat 'kubectl wait --for=condition=ready pod -l app=mysql --timeout=300s'
                        }
                        
                        // Get Minikube service URL
                        if (fileExists('k8s/service.yaml')) {
                            bat 'minikube service immunization-service --url > service-url.txt'
                            def serviceUrl = readFile('service-url.txt').trim()
                            echo "Application deployed at: ${serviceUrl}"
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            // Clean up workspace but preserve service URL if needed
            script {
                if (fileExists('ImmunizationTracker/service-url.txt')) {
                    archiveArtifacts artifacts: 'ImmunizationTracker/service-url.txt'
                }
            }
            cleanWs()
        }
        success {
            script {
                if (fileExists('ImmunizationTracker/service-url.txt')) {
                    def url = readFile('ImmunizationTracker/service-url.txt').trim()
                    emailext body: "Deployment successful!\nAccess your application at: ${url}", 
                            subject: 'Deployment Success', 
                            to: 'your-email@example.com'
                }
            }
        }
    }
}
