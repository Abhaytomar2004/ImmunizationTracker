pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
        MINIKUBE_HOME = 'C:/minikube'
        KUBECONFIG = "${env.MINIKUBE_HOME.replace('\\','/')}/config"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}")
                        env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', env.DOCKERHUB_CREDENTIALS) {
                        docker.image(env.IMAGE_NAME).push()
                    }
                }
            }
        }
        // ---- Kubernetes Steps Start Here (fixed and simplified) ----
        stage('Start Minikube') {
            steps {
                script {
                    bat 'minikube stop || echo "No cluster to stop"'
                    bat 'minikube delete || echo "No cluster to delete"'
                    bat 'minikube start --driver=docker --cpus=2 --memory=4096'
                    bat 'minikube update-context'
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                dir('ImmunizationTracker/k8s') {
                    script {
                        bat 'kubectl apply -f mysql-pv.yaml'
                        bat 'kubectl apply -f mysql-deployment.yaml'
                        bat 'kubectl apply -f deployment.yaml'
                        bat 'kubectl apply -f service.yaml'
                        bat 'kubectl rollout status deployment/mysql --timeout=300s'
                        bat 'kubectl rollout status deployment/immunization-tracker --timeout=300s'
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
