pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Test') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn test -DskipTests'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        // Build Docker image with your Docker Hub username
                        def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                        // Store image name in environment variable for later stages
                        env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        def image = docker.image(env.IMAGE_NAME)
                        image.push()
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            when {
                expression {
                    return fileExists('ImmunizationTracker/k8s/deployment.yaml')
                }
            }
            steps {
                dir('ImmunizationTracker') {
                    // Optional: You can wrap with kubeconfig credentials if needed
                    withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                        script {
                            def base = 'k8s'
                            def files = ['mysql-pv.yaml', 'mysql-deployment.yaml', 'deployment.yaml', 'service.yaml']
                            for (f in files) {
                                if (fileExists("${base}/${f}")) {
                                    bat "kubectl apply -f ${base}/${f}"
                                } else {
                                    echo "Skipped: ${f} not found."
                                }
                            }
                            // Wait for MySQL pod only if its deployment exists
                            if (fileExists("${base}/mysql-deployment.yaml")) {
                                bat 'kubectl wait --for=condition=ready pod -l app=mysql --timeout=120s'
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
