pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-credentials')
        KUBECONFIG = "C:\\Users\\YourUser\\.kube\\config"
        MINIKUBE_HOME = "C:\\minikube"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'JAV-01', url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git'
            }
        }
        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Test') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn test' // Remove -DskipTests to actually run tests
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}", ".")
                        env.IMAGE_NAME = image.imageName()
                    }
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') {
                        docker.image(env.IMAGE_NAME).push()
                    }
                }
            }
        }
        stage('Verify Kubernetes Cluster') {
            steps {
                script {
                    bat 'kubectl config view'
                    bat 'kubectl cluster-info || minikube status'
                    bat 'minikube status || minikube start'
                    bat 'minikube update-context'
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        bat 'kubectl apply -f k8s/mysql-pv.yaml --validate=false'
                        bat 'kubectl apply -f k8s/mysql-deployment.yaml --validate=false'
                        // Retry logic for MySQL pod readiness
                        retry(3) {
                            bat 'kubectl wait --for=condition=ready pod -l app=mysql --timeout=120s'
                        }
                        bat 'kubectl apply -f k8s/deployment.yaml --validate=false'
                        bat 'kubectl apply -f k8s/service.yaml --validate=false'
                    }
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
