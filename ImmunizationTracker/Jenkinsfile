pipeline {
    agent any
    tools {
        maven 'Maven 3.9.9'
        jdk 'JDK-21'
    }
    environment {
        DOCKER_CONFIG = "${env.WORKSPACE}/.docker"
        MINIKUBE_HOME = 'C:/minikube'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM', 
                    branches: [[name: 'JAV-01']],
                    userRemoteConfigs: [[url: 'https://github.com/Abhaytomar2004/ImmunizationTracker.git']]
                ])
            }
        }

        stage('Build') {
            steps {
                dir('ImmunizationTracker') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('ImmunizationTracker') {
                    script {
                        def image = docker.build("arnold21/immunizationtracker:${env.BUILD_ID}")
                        env.IMAGE_NAME = image.imageName()
                        
                        withCredentials([usernamePassword(
                            credentialsId: 'docker-hub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_TOKEN'
                        )]) {
                            bat """
                                echo %DOCKER_TOKEN% | docker login -u %DOCKER_USER% --password-stdin
                                docker push ${env.IMAGE_NAME}
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                script {
                    // Ensure Minikube is running
                    bat 'minikube status || minikube start --driver=docker --force'
                    
                    // Apply manifests
                    dir('ImmunizationTracker/k8s') {
                        bat 'kubectl apply -f mysql-pv.yaml'
                        bat 'kubectl apply -f mysql-deployment.yaml'
                        bat 'kubectl apply -f deployment.yaml'
                        bat 'kubectl apply -f service.yaml'
                    }
                }
            }
        }

        // NEW: Deployment Verification Stage
        stage('Verify Deployment') {
            steps {
                script {
                    // 1. Check rollout status with timeout
                    timeout(time: 5, unit: 'MINUTES') {
                        bat 'kubectl rollout status deployment/immunization-tracker --timeout=300s'
                    }

                    // 2. Verify pod status
                    def podStatus = bat(script: 'kubectl get pods -l app=immunization-tracker -o jsonpath="{.items[0].status.phase}"', returnStdout: true).trim()
                    if (podStatus != "Running") {
                        error("Pod failed to start. Current status: ${podStatus}")
                    }

                    // 3. Get service URL and test connectivity
                    def minikubeIp = bat(script: 'minikube ip', returnStdout: true).trim()
                    def nodePort = bat(script: 'kubectl get svc immunization-service -o jsonpath=\'{.spec.ports[0].nodePort}\'', returnStdout: true).trim()
                    def serviceUrl = "http://${minikubeIp}:${nodePort}"

                    // 4. Basic health check
                    def healthCheck = bat(script: "curl -s -o /dev/null -w \"%{http_code}\" ${serviceUrl}/actuator/health || echo 500", returnStdout: true).trim()
                    if (healthCheck != "200") {
                        error("Health check failed with status: ${healthCheck}")
                    }

                    // 5. Log application startup logs
                    def podName = bat(script: 'kubectl get pods -l app=immunization-tracker -o jsonpath="{.items[0].metadata.name}"', returnStdout: true).trim()
                    bat "kubectl logs ${podName} --tail=50"
                }
            }
        }
    }
    post {
        always {
            // Cleanup and get final status
            script {
                bat 'kubectl get pods -o wide'
                bat 'kubectl get svc'
                cleanWs()
            }
        }
    }
}
